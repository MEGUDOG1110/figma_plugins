{
  "name": "figma-plugins",
  "private": true,
  "version": "1.0.0",
  "description": "Figmaプラグインの開発リポジトリ",
  "scripts": {
    "build": "npm run typecheck && npm run build:plugin && npm run build:ui",
    "build:plugin": "vite build --config config/vite.plugin.ts",
    "build:ui": "vite build --config config/vite.ui.ts",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:plugin\" \"npm:dev:ui\"",
    "dev:plugin": "vite build --watch --config config/vite.plugin.ts",
    "dev:ui": "vite build --watch --config config/vite.ui.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.ui.json",
    "watch": "npm run dev"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
